CASE nv12_crop
SRC w=640 h=480 bpl=640 sz=460800 cs=8
CROP set=160,128 320x240 -> got=160,128 320x240
CAP w=320 h=240 bpl=320 sz=115200 cs=8 fourcc=NV12
READ src=460800
RESULT status=OK bytesused=115200 wrote=115200

