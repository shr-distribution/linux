# Palm A6 Battery Controller Configuration
#

config A6
	tristate "Palm A6 battery controller"
	depends on I2C && OF
	select REGMAP_I2C
	help
	  Support for Palm A6 battery controllers used in HP TouchPad.
	  These are TI MSP430 microcontrollers providing battery monitoring,
	  power management, and Touchstone inductive charging support.

	  The driver provides battery information through the power_supply
	  class and firmware update capability via character device interface.

	  To compile this driver as a module, choose M here: the module
	  will be called a6.

config A6_I2C_SINGLE_BYTE
	bool "Enable A6 I2C single byte read"
	depends on A6
	help
	  Enable single byte I2C read operations for A6 driver.
	  This may be needed for compatibility with certain I2C controllers.

	  If unsure, say N.

config A6_I2C_SINGLE_BYTE_WRITE
	bool "Enable A6 I2C single byte write"
	depends on A6
	help
	  Enable single byte I2C write operations for A6 driver.
	  This may be needed for compatibility with certain I2C controllers.

	  If unsure, say N.
