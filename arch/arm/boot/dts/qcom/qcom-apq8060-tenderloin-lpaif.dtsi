// SPDX-License-Identifier: GPL-2.0-only
/*
 * HP TouchPad (Tenderloin) Audio via direct LPAIF hardware
 *
 * This is an ALTERNATIVE audio configuration that uses direct LPAIF
 * hardware access instead of the Q6 DSP path. This approach is similar
 * to how the original webOS kernel handled audio.
 *
 * To use this instead of the Q6/APR path:
 * 1. Include this file AFTER qcom-apq8060-tenderloin-common.dtsi
 * 2. Enable CONFIG_SND_SOC_APQ8060_LPAIF in kernel config
 * 3. Disable CONFIG_SND_SOC_APQ8060 (optional, to save memory)
 *
 * Benefits:
 * - No DSP firmware required
 * - Simpler audio path
 * - More similar to webOS audio handling
 *
 * Drawbacks:
 * - No DSP-based audio processing
 * - Must handle all I2S clocking in kernel
 */

/* Disable the Q6/APR-based sound card */
/ {
	sound {
		status = "disabled";
	};
};

/* Disable the Q6 LPASS remoteproc (not needed for direct LPAIF) */
&lpass {
	status = "disabled";
};

&apr {
	status = "disabled";
};

/* Enable the direct LPAIF hardware interface */
&lpaif {
	status = "okay";
};

/* Sound card using direct LPAIF path */
/ {
	sound_lpaif: sound-lpaif {
		compatible = "qcom,apq8060-lpaif-sndcard";
		model = "HP-TouchPad-LPAIF";

		/*
		 * Primary I2S pinctrl - same as Q6 path.
		 * GPIO 108 (WS) and GPIO 109 (SCK) for codec I2S.
		 */
		pinctrl-names = "default";
		pinctrl-0 = <&primary_i2s_pins>;

		/*
		 * Speaker amplifier control via WM8958 GPIO1.
		 * The codec handles this internally, no SoC GPIO needed.
		 */

		/*
		 * DAPM audio routing - same as Q6 path.
		 */
		audio-routing =
			"Headphone", "HPOUT1L",
			"Headphone", "HPOUT1R",
			"Speaker", "LINEOUT1P",
			"Speaker", "LINEOUT1N",
			"Speaker", "LINEOUT2P",
			"Speaker", "LINEOUT2N",
			"IN1LN", "Internal Mic",
			"IN2LN", "Headset Mic";

		/*
		 * Single DAI link: LPAIF codec speaker port to WM8958.
		 *
		 * The LPAIF "codec-spkr" DAI (port 0) connects to the
		 * WM8958 AIF1 interface for stereo playback.
		 */
		codec-dai-link {
			link-name = "Codec Speaker";
			cpu {
				sound-dai = <&lpaif 0>;  /* codec-spkr port */
			};
			codec {
				sound-dai = <&wm8958>;
			};
		};

		/*
		 * Capture DAI link: LPAIF codec mic port to WM8958.
		 */
		mic-dai-link {
			link-name = "Codec Mic";
			cpu {
				sound-dai = <&lpaif 1>;  /* codec-mic port */
			};
			codec {
				sound-dai = <&wm8958>;
			};
		};
	};
};
