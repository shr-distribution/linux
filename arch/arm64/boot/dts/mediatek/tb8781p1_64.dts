   hynitron@58 {
        compatible = "hyn,66xx";
        reg = <0x58>;
//        vdd_ana-supply = <&pm8953_l10>;
//        vcc_i2c-supply = <&pm8953_l6>;

        interrupt-parent = <&pio>;
        interrupts = <9 IRQ_TYPE_EDGE_FALLING 9 0>;
        reset-gpio = <&pio 152 0>;
        irq-gpio = <&pio 9 0>;
        vdd-gpio = <&pio 153 0>;
        
        pinctrl-names = "ts_active","ts_suspend";
#if 1
        pinctrl-0 = <&ts_int_active &ts_reset_active &ts_scl_active &ts_sda_active>;
        pinctrl-1 = <&ts_int_suspend &ts_reset_suspend &ts_scl_suspend &ts_sda_suspend>;
#else
        pinctrl-0 = <&ts_int_active &ts_reset_active>;
        pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
#endif
        max-touch-number = <5>;
        display-coords = <0 0 1080 1240>;
        pos-swap = <0>;
        posx-reverse = <0>;
        posy-reverse = <0>;

        key-number = <0>;
        keys = <139 102 158>;
        key-y-coord = <2000>;
        key-x-coords = <200 600 800>;
    };
};
&pio {
	ts_int_active: ts_int_active {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			  input-enable;
                };
	};
	ts_reset_active: ts_reset_active {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO152__FUNC_GPIO152>;
			output-high;
                };
	};
#if 1
	ts_scl_active: ts_scl_active {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO130__FUNC_SCL0>;
		};
	};
	ts_sda_active: ts_sda_active {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO131__FUNC_SDA0>;
		};
	};
#endif
	ts_int_suspend: ts_int_suspend {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			output-low;
                };
	};
	ts_reset_suspend: ts_reset_suspend {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO152__FUNC_GPIO152>;
			output-low;
                };
	};
#if 1
	ts_scl_suspend: ts_scl_suspend {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO130__FUNC_GPIO130>;
			output-low;
		};
	};
	ts_sda_suspend: ts_sda_suspend {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO131__FUNC_GPIO131>;
			output-low;
		};
	};
#endif
};

