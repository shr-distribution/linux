/* CAMERA GPIO standardization */
&pio {
	camera_pins_cam0_rst_0: cam0@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO15__FUNC_GPIO15>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam0_rst_1: cam0@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO15__FUNC_GPIO15>;
			slew-rate = <1>;
			output-high;
		};
	};	
	camera_pins_cam0_ldo_vcamd_0: cam0@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam0_ldo_vcamd_1: cam0@3 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <1>;
			output-high;
		};
	};
	camera_pins_cam0_ldo_vcama_0: cam0@4 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam0_ldo_vcama_1: cam0@5 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <1>;
			output-high;
		};
	};
	camera_pins_cam0_ldo_vcamio_0: cam0@6 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_GPIO22>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam0_ldo_vcamio_1: cam0@7 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_GPIO22>;
			slew-rate = <1>;
			output-high;
		};
	};

#if 1
	camera_pins_cam0_ldo_vcamafvdd_0: cam0@10 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO151__FUNC_GPIO151>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam0_ldo_vcamafvdd_1: cam0@11 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO151__FUNC_GPIO151>;
			slew-rate = <1>;
			output-high;
		};
	};
#endif	
	camera_pins_cam1_rst_0: cam1@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO15__FUNC_GPIO15>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam1_rst_1: cam1@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO15__FUNC_GPIO15>;
			slew-rate = <1>;
			output-high;
		};
	};	
	camera_pins_cam1_ldo_vcamd_0: cam1@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam1_ldo_vcamd_1: cam1@3 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <1>;
			output-high;
		};
	};
	camera_pins_cam1_ldo_vcama_0: cam1@4 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam1_ldo_vcama_1: cam1@5 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <1>;
			output-high;
		};
	};
	camera_pins_cam1_ldo_vcamio_0: cam1@6 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_GPIO22>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam1_ldo_vcamio_1: cam1@7 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_GPIO22>;
			slew-rate = <1>;
			output-high;
		};
	};

#if 1
	camera_pins_cam1_ldo_vcamafvdd_0: cam1@10 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO151__FUNC_GPIO151>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam1_ldo_vcamafvdd_1: cam1@11 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO151__FUNC_GPIO151>;
			slew-rate = <1>;
			output-high;
		};
	};
#endif	

	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_GPIO126>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam0_mclk_2ma: camera_pins_cam0_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <0>;
		};
	};
	camera_pins_cam0_mclk_4ma: camera_pins_cam0_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam0_mclk_6ma: camera_pins_cam0_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <2>;
		};
	};
	camera_pins_cam0_mclk_8ma: camera_pins_cam0_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <3>;
		};
	};
	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_GPIO126>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam1_mclk_2ma: camera_pins_cam1_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <0>;
		};
	};
	camera_pins_cam1_mclk_4ma: camera_pins_cam1_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam1_mclk_6ma: camera_pins_cam1_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <2>;
		};
	};
	camera_pins_cam1_mclk_8ma: camera_pins_cam1_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO126__FUNC_CMMCLK0>;
			drive-strength = <3>;
		};
	};
	camera_pins_cam2_mclk_off: camera_pins_cam2_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO129__FUNC_GPIO129>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam2_mclk_2ma: camera_pins_cam2_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO129__FUNC_CMMCLK3>;
			drive-strength = <0>;
		};
	};
	camera_pins_cam2_mclk_4ma: camera_pins_cam2_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO129__FUNC_CMMCLK3>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam2_mclk_6ma: camera_pins_cam2_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO129__FUNC_CMMCLK3>;
			drive-strength = <2>;
		};
	};
	camera_pins_cam2_mclk_8ma: camera_pins_cam2_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO129__FUNC_CMMCLK3>;
			drive-strength = <3>;
		};
	};
	camera_pins_default: camdefault {
	};
};
&kd_camera_hw1 {
	pinctrl-names = "default",
			"cam0_rst0", "cam0_rst1",
//			"cam0_pnd0", "cam0_pnd1",
			"cam1_rst0", "cam1_rst1",

			"cam0_mclk_off",
			"cam0_mclk_2mA", "cam0_mclk_4mA",
			"cam0_mclk_6mA", "cam0_mclk_8mA",

			"cam1_mclk_off",
			"cam1_mclk_2mA", "cam1_mclk_4mA",
			"cam1_mclk_6mA", "cam1_mclk_8mA",

			"cam2_mclk_off",
			"cam2_mclk_2mA", "cam2_mclk_4mA",
			"cam2_mclk_6mA", "cam2_mclk_8mA",

			"cam0_ldo_vcama_0", "cam0_ldo_vcama_1",
			"cam0_ldo_vcamd_0", "cam0_ldo_vcamd_1",
			"cam0_ldo_vcamio_0", "cam0_ldo_vcamio_1",
			"cam0_ldo_vcamafvdd_0", "cam0_ldo_vcamafvdd_1",

			"cam1_ldo_vcama_0", "cam1_ldo_vcama_1",
			"cam1_ldo_vcamd_0", "cam1_ldo_vcamd_1",
			"cam1_ldo_vcamio_0", "cam1_ldo_vcamio_1",
			"cam1_ldo_vcamafvdd_0", "cam1_ldo_vcamafvdd_1";

	pinctrl-0 = <&camera_pins_default>;
	pinctrl-1 = <&camera_pins_cam0_rst_0>;
	pinctrl-2 = <&camera_pins_cam0_rst_1>;
	pinctrl-3 = <&camera_pins_cam1_rst_0>;
	pinctrl-4 = <&camera_pins_cam1_rst_1>;
	pinctrl-5 = <&camera_pins_cam0_mclk_off>;
	pinctrl-6 = <&camera_pins_cam0_mclk_2ma>;
	pinctrl-7 = <&camera_pins_cam0_mclk_4ma>;
	pinctrl-8 = <&camera_pins_cam0_mclk_6ma>;
	pinctrl-9 = <&camera_pins_cam0_mclk_8ma>;
	pinctrl-10= <&camera_pins_cam1_mclk_off>;
	pinctrl-11 = <&camera_pins_cam1_mclk_2ma>;
	pinctrl-12 = <&camera_pins_cam1_mclk_4ma>;
	pinctrl-13 = <&camera_pins_cam1_mclk_6ma>;
	pinctrl-14 = <&camera_pins_cam1_mclk_8ma>;
	pinctrl-15 = <&camera_pins_cam2_mclk_off>;
	pinctrl-16 = <&camera_pins_cam2_mclk_2ma>;
	pinctrl-17 = <&camera_pins_cam2_mclk_4ma>;
	pinctrl-18 = <&camera_pins_cam2_mclk_6ma>;
	pinctrl-19 = <&camera_pins_cam2_mclk_8ma>;

	pinctrl-20 = <&camera_pins_cam0_ldo_vcama_0>;
	pinctrl-21 = <&camera_pins_cam0_ldo_vcama_1>;
	pinctrl-22 = <&camera_pins_cam0_ldo_vcamd_0>;
	pinctrl-23 = <&camera_pins_cam0_ldo_vcamd_1>;
	pinctrl-24 = <&camera_pins_cam0_ldo_vcamio_0>;
	pinctrl-25 = <&camera_pins_cam0_ldo_vcamio_1>;
	pinctrl-26 = <&camera_pins_cam0_ldo_vcamafvdd_0>;
	pinctrl-27 = <&camera_pins_cam0_ldo_vcamafvdd_1>;

	pinctrl-28 = <&camera_pins_cam1_ldo_vcama_0>;
	pinctrl-29 = <&camera_pins_cam1_ldo_vcama_1>;
	pinctrl-30 = <&camera_pins_cam1_ldo_vcamd_0>;
	pinctrl-31 = <&camera_pins_cam1_ldo_vcamd_1>;
	pinctrl-32 = <&camera_pins_cam1_ldo_vcamio_0>;
	pinctrl-33 = <&camera_pins_cam1_ldo_vcamio_1>;
	pinctrl-34 = <&camera_pins_cam1_ldo_vcamafvdd_0>;
	pinctrl-35 = <&camera_pins_cam1_ldo_vcamafvdd_1>;
#if 0
	/* main (wide)*/
	cam0_vcama-supply = <&rt5133_ldo4>;
	cam0_vcamio-supply = <&rt5133_ldo1>;
	cam0_vcamd-supply = <&rt5133_ldo8>;
	cam0_vcama1-supply = <&rt5133_ldo5>;
	cam0_vcamaf-supply = <&rt5133_ldo3>;

	/* front*/
	cam1_vcama-supply = <&rt5133_ldo6>;
	cam1_vcamio-supply = <&rt5133_ldo1>;
	cam1_vcamd-supply = <&rt5133_ldo7>;
	cam1_vcama1-supply = <&rt5133_ldo5>;
	cam1_vcamaf-supply = <&rt5133_ldo2>;

	/* main2 (Ultra Wide)*/
	cam2_vcama-supply = <&rt5133_gpio2>;
	cam2_vcamio-supply = <&rt5133_ldo1>;
	cam2_vcamd-supply = <&rt5133_ldo7>;
	cam2_vcama1-supply = <&rt5133_ldo5>;
	cam2_vcamaf-supply = <&rt5133_gpio1>;
#endif
	cam0_pin_mclk = "mclk";
	cam0_pin_rst = "gpio";
//	cam0_pin_pnd = "gpio";
	cam0_pin_vcama = "gpio";
	cam0_pin_vcamio = "gpio";
	cam0_pin_vcamd = "gpio";
	cam0_pin_vcama1 = "regulator";
	cam0_pin_vcamaf = "gpio";
	cam1_pin_mclk = "mclk";
	cam1_pin_rst = "gpio";
	cam1_pin_vcama = "gpio";
	cam1_pin_vcamio = "gpio";
	cam1_pin_vcamd = "gpio";
	cam1_pin_vcama1 = "regulator";
	cam1_pin_vcamaf = "gpio";
	cam2_pin_mclk = "mclk";
	cam2_pin_rst = "gpio";
	cam2_pin_vcama = "regulator";
	cam2_pin_vcamio = "regulator";
	cam2_pin_vcamd = "regulator";
	cam2_pin_vcama1 = "regulator";
	cam2_pin_vcamaf = "gpio";
	status = "okay";
};
/* CAMERA GPIO end */

/* CAMERA EEPROM */
&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;
#if 0
	mtk_camera_eeprom1:camera_eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};
#endif
	mtk_camera_eeprom0:camera_eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};
	
	camera_main_mtk:camera_main@10 {
		compatible = "mediatek,camera_main";
		#thermal-sensor-cells = <0>;
		reg = <0x10>;
		status = "okay";
	};
	camera_sub_mtk:camera_sub@1a {
		compatible = "mediatek,camera_sub";
		#thermal-sensor-cells = <0>;
		reg = <0x1a>;
		status = "okay";
	};
};
/* CAMERA EEPROM end */

/* CAMERA TZ config */
&thermal_zones {
	camera_main: camera_main {
		polling-delay = <1000>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&camera_main_mtk>;
	};
	camera_sub: camera_sub {
		polling-delay = <1000>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&camera_sub_mtk>;
	};
#if 0
	camera_main_two: camera_main_two {
		polling-delay = <1000>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&camera_main_two_mtk>;
	};
#endif
};
/* CAMERA TZ config end */
